 974          void tracking(void)
 975          {
 976   1              P0 = 0xff;              //检测黑线                                                                                                                   
 977   1              qtis = P0 & 0x0f;       //读取4个巡线传感器的值
 978   1              qtis_color = P0 & 0x30;         //两个qti放物块
 979   1              Fast_forward(1);//前进一小步
 980   1              switch(qtis)    //按照4个巡线传感器的值执行移动指令，巡线
 981   1              {
 982   2                      case 1:step++;turn(1550,1550);break;      //大幅向右转
C51 COMPILER V9.54   MAIN                                                                  10/25/2025 15:38:44 PAGE 17  

 983   2                      case 2:step++;break;     
 984   2                      case 3:step++;turn(1550,1500);break;      //小幅向右转
 985   2                      case 8:step++;turn(1450,1450);break;      //大幅向左转
 986   2                      case 4:step++;break;
 987   2                      case 12:step++;turn(1500,1450);break;     //小幅向左转
 988   2                      case 5:step++;break;
 989   2                      case 6:step++;break;
 990   2                      case 7:step++;break;
 991   2                      case 10:step++;break;
 992   2                      case 13:step++;break;
 993   2                      case 14:step++;break;
 994   2                      case 15:Fast_forward(6);break;    //向前2小步                       
 995   2              }
