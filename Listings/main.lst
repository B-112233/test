1003          void tracking(void)
1004          {
1005   1              P0 = 0xff;              //检测黑线                                                                                                                   
1006   1              qtis = P0 & 0x0f;       //读取4个巡线传感器的值
1007   1              qtis_color = P0 & 0x30;         //两个qti放物块
1008   1              Fast_forward(1);//前进一小步
1009   1              switch(qtis)    //按照4个巡线传感器的值执行移动指令，巡线
1010   1              {
1011   2                      case 1:step++;turn(1550,1550);break;      //大幅向右转
1012   2                      case 2:step++;break;     
1013   2                      case 3:step++;turn(1550,1500);break;      //小幅向右转
1014   2                      case 8:step++;turn(1450,1450);break;      //大幅向左转
1015   2                      case 4:step++;break;
1016   2                      case 12:step++;turn(1500,1450);break;     //小幅向左转
1017   2                      case 5:step++;break;
1018   2                      case 6:step++;break;
1019   2                      case 7:step++;break;
1020   2                      case 10:step++;break;
1021   2                      case 13:step++;break;
1022   2                      case 14:step++;break;
1023   2                      case 15:Fast_forward(6);break;    //向前2小步                       
1024   2              }
1025   1      }
