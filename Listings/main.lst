 984          void tracking(void)
 985          {
 986   1              P0 = 0xff;              //检测黑线                                                                                                                   
 987   1              qtis = P0 & 0x0f;       //读取4个巡线传感器的值
 988   1              qtis_color = P0 & 0x30;         //两个qti放物块
 989   1              Fast_forward(1);//前进一小步
 990   1              switch(qtis)    //按照4个巡线传感器的值执行移动指令，巡线
 991   1              {
 992   2                      case 1:step++;turn(1550,1550);break;      //大幅向右转
 993   2                      case 2:step++;break;     
 994   2                      case 3:step++;turn(1550,1500);break;      //小幅向右转
 995   2                      case 8:step++;turn(1450,1450);break;      //大幅向左转
 996   2                      case 4:step++;break;
 997   2                      case 12:step++;turn(1500,1450);break;     //小幅向左转
 998   2                      case 5:step++;break;
 999   2                      case 6:step++;break;
1000   2                      case 7:step++;break;
1001   2                      case 10:step++;break;
1002   2                      case 13:step++;break;
1003   2                      case 14:step++;break;
1004   2                      case 15:Fast_forward(6);break;    //向前2小步                       
1005   2              }
1006   1      }
