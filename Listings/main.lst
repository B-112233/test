 956          void tracking(void)
 957          {
 958   1              P0 = 0xff;              //检测黑线                                                                                                                   
 959   1              qtis = P0 & 0x0f;       //读取4个巡线传感器的值
 960   1              qtis_color = P0 & 0x30;         //两个qti放物块
 961   1              Fast_forward(1);//前进一小步
 962   1              switch(qtis)    //按照4个巡线传感器的值执行移动指令，巡线
 963   1              {
 964   2                      case 1:step++;turn(1550,1550);break;      //大幅向右转
 965   2                      case 2:step++;break;     
 966   2                      case 3:step++;turn(1550,1500);break;      //小幅向右转
 967   2                      case 8:step++;turn(1450,1450);break;      //大幅向左转
 968   2                      case 4:step++;break;
 969   2                      case 12:step++;turn(1500,1450);break;     //小幅向左转
 970   2                      case 5:step++;break;
 971   2                      case 6:step++;break;
 972   2                      case 7:step++;break;
 973   2                      case 10:step++;break;
 974   2                      case 13:step++;break;
 975   2                      case 14:step++;break;
 976   2                      case 15:Fast_forward(6);break;    //向前2小步                       
 977   2              }
 978   1      }
